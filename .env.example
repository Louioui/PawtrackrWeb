# ============================================================================
# PAWTRACKR WEB — ENVIRONMENT CONFIGURATION
# ============================================================================

# Demo routes do not use these credentials. The live staff, sign-up, and public
# booking routes use the Supabase URL and publishable key. SUPABASE_SERVICE_ROLE_KEY
# is used only by the Stripe webhook, after the event signature is verified.
# STRIPE_SECRET_KEY starts card payments; STRIPE_WEBHOOK_SECRET verifies events.
# Supabase Multi-Tenant PostgreSQL + RLS
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe Connect (POS Transactions) & Stripe Billing ($119-$149/mo SaaS Plans)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_key"
STRIPE_SECRET_KEY="sk_live_your_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_SOLO_PLAN_PRICE_ID="price_pawtrackr_solo_119"
STRIPE_SALON_PLAN_PRICE_ID="price_pawtrackr_salon_149"

# Distributed API rate limiting (server-side only)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-standard-token"

# App Public Domain
NEXT_PUBLIC_APP_URL="https://pawtrackr.live"

# `npm run check:production-env` is a fail-closed release gate. It requires a
# hosted HTTPS app origin, a hosted Supabase URL, separate public/server keys,
# live Stripe keys, a webhook secret, both live plan price IDs, and server-side
# Upstash Redis credentials for distributed rate limiting. It reports
# variable names and validation reasons but never prints credential values.

# Optional local demo ledger directory for isolated QA runs.
# PAWTRACKR_DEMO_DATA_DIR="/tmp/pawtrackr-demo-qa"
